<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Base configuration: Strictly HTTPS only, reject cleartext traffic -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Production domain configuration -->
    <domain-config>
        <domain includeSubdomains="true">zeroday.gg</domain>
        <domain includeSubdomains="true">api.zeroday.gg</domain>
        <domain includeSubdomains="true">pwnify.app</domain>
        <domain includeSubdomains="true">api.pwnify.app</domain>
    </domain-config>

    <!-- Debug overrides for local development only -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
