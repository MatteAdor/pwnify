# =====================================================================
# ZERODAY CYBER WARFARE ACADEMY - ENVIRONMENT TEMPLATE (.env.example)
# =====================================================================
# Use this template to configure local development or remote CI/CD.
# NEVER commit real credentials or production tokens to git!
# =====================================================================

# --- CLIENT-SIDE (Vite Public - Embedded into Frontend Bundle) ---
VITE_APP_ENV=development
VITE_GOOGLE_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_LEMONSQUEEZY_ANNUAL_URL=https://zeroday-app.lemonsqueezy.com/checkout/buy/...
VITE_LEMONSQUEEZY_MONTHLY_URL=https://zeroday-app.lemonsqueezy.com/checkout/buy/...
VITE_LEMONSQUEEZY_STARTER_URL=https://zeroday-app.lemonsqueezy.com/checkout/buy/...
VITE_ENABLE_REAL_CHECKOUT_REDIRECT=false

# --- SELF-HOSTED PEERSERVER CONFIGURATION ---
VITE_PEER_HOST=peer.zeroday.gg
VITE_PEER_PORT=443
VITE_PEER_SECURE=true
VITE_PEER_PATH=/peerjs
VITE_PEER_KEY=zeroday-pvp

# --- BACKEND SECRETS (Edge Functions / GitHub Secrets / CI ONLY) ---
# NEVER expose these in frontend or commit to version control!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_ACCESS_TOKEN=sbp_...
SUPABASE_PROD_PROJECT_ID=your-prod-project-ref
SUPABASE_STAGING_PROJECT_ID=your-staging-project-ref
SUPABASE_PROD_DB_URL=postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# --- TURN CREDENTIAL PROVIDERS (Supabase Edge Function Secrets) ---
METERED_API_KEY=your-metered-api-key
METERED_DOMAIN=your-subdomain.metered.ca

# --- LEMON SQUEEZY WEBHOOKS & SERVER SECRETS ---
LEMONSQUEEZY_API_KEY=your-lemonsqueezy-api-key
LEMONSQUEEZY_STORE_ID=your-store-id
LEMONSQUEEZY_WEBHOOK_SECRET=your-webhook-secret
VITE_GITHUB_CLIENT_SECRET=

# --- DISASTER RECOVERY & QUESTION BANK SECRETS ---
# 32-byte secret passphrase used to decrypt questions bank (AES-256-GCM + scrypt)
QUESTION_BANK_KEY=your-secure-32-byte-encryption-passphrase
QUESTION_BANK_REMOTE_URL=https://private-bucket.r2.cloudflarestorage.com/questions_bank.json.enc
BACKUP_ENCRYPTION_KEY=your-secure-backup-passphrase
BACKUP_S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
BACKUP_BUCKET_NAME=zeroday-encrypted-backups
BACKUP_S3_ACCESS_KEY_ID=your-s3-access-key-id
BACKUP_S3_SECRET_ACCESS_KEY=your-s3-secret-access-key

# --- ANDROID CI/CD SIGNING (GitHub Secrets ONLY as Base64) ---
# Base64 string: base64 -w 0 my-release-key.jks
ANDROID_KEYSTORE_BASE64=
ANDROID_KEY_ALIAS=zeroday-release
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_PASSWORD=
