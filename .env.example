# =====================================================================
# ZERODAY CYBER WARFARE ACADEMY - ENVIRONMENT TEMPLATE (.env.example)
# =====================================================================
# Copia questo file in .env e compila con le tue credenziali API.
# =====================================================================

# Google OAuth 2.0 Web Client ID
VITE_GOOGLE_CLIENT_ID=

# GitHub OAuth App Client ID
VITE_GITHUB_CLIENT_ID=
VITE_GITHUB_CLIENT_SECRET=

# Database & Storage
VITE_APP_ENV=development
VITE_DATABASE_PATH=database/logins.json

# =====================================================================
# STRIPE PAYMENTS (TEST MODE)
# =====================================================================
# Chiave pubblicabile (lato client - safe in frontend)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Chiave segreta / Restricted Key (SOLO lato backend/script - MAI nel client o in git)
STRIPE_SECRET_KEY=sk_test_...

# Webhook Signing Secret (generato da Stripe CLI o Dashboard per la verifica firma)
STRIPE_WEBHOOK_SECRET=whsec_...

# Abilita redirect reale a Stripe Checkout (invece del mock/license restore in dev)
VITE_ENABLE_REAL_STRIPE_REDIRECT=false
