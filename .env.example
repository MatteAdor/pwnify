# Google OAuth 2.0 Web Client ID
VITE_GOOGLE_CLIENT_ID=

# GitHub OAuth App Client ID
VITE_GITHUB_CLIENT_ID=
VITE_GITHUB_CLIENT_SECRET=

# Database & Storage
VITE_APP_ENV=development
VITE_DATABASE_PATH=database/logins.json
